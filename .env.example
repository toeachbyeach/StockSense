# StockSense Configuration Template
# Copy this file to .env and adjust variables as desired.

# Server Port & Timezone
PORT=3000
TZ=Australia/Sydney

# Authentication & Encryption
# Set a strong admin password for web dashboard login
PASSWORD=changeme123

# 32-character secret key used to sign JWTs and securely encrypt sensitive notification tokens
ENCRYPTION_KEY=replace-with-a-random-32-character-secret-key

# Detection Thresholds
DEFAULT_SALE_THRESHOLD=20
DEFAULT_MIN_HISTORY=3

# Puppeteer / Browser Options (optional)
# HEADLESS=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
